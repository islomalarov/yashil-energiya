NEXT_PUBLIC_HYGRAPH_ENDPOINT=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-Q1YP3BBCL1

TURNSTILE_SECRET_KEY=

# Dedicated Turnstile key pair for the virtual assistant, in "Invisible" widget
# mode (Cloudflare dashboard). Optional: if left empty, the assistant reuses the
# shared TURNSTILE_* keys above. Set the public site key and the secret together.
NEXT_PUBLIC_TURNSTILE_ASSISTANT_SITE_KEY=
TURNSTILE_ASSISTANT_SECRET_KEY=

# Shared secret for the Hygraph -> /api/revalidate webhook (on-demand cache purge).
HYGRAPH_REVALIDATE_SECRET=

MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=
MS_RECIPIENT_EMAIL=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Gemini API key for the virtual assistant (aistudio.google.com).
GEMINI_API_KEY=
