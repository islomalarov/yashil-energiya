# Sanity CMS (public values: the dataset is public, only published content is read).
NEXT_PUBLIC_SANITY_PROJECT_ID=ljlv76fi
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-Q1YP3BBCL1

TURNSTILE_SECRET_KEY=

# Dedicated Turnstile key pair for the virtual assistant, in "Invisible" widget
# mode (Cloudflare dashboard). Optional: if left empty, the assistant reuses the
# shared TURNSTILE_* keys above. Set the public site key and the secret together.
NEXT_PUBLIC_TURNSTILE_ASSISTANT_SITE_KEY=
TURNSTILE_ASSISTANT_SECRET_KEY=

# Secret of the Sanity webhook -> /api/revalidate (signs requests; on-demand cache purge).
SANITY_REVALIDATE_SECRET=

# Local only, never in Vercel: Editor token for importing content into Sanity
# (scripts/sanity-migration, see docs/migration-hygraph-to-sanity.md).
SANITY_API_WRITE_TOKEN=

MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=
MS_RECIPIENT_EMAIL=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Gemini API key for the virtual assistant (aistudio.google.com).
GEMINI_API_KEY=
